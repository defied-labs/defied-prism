{
  "name": "@defied-labs/prism-cli",
  "version": "0.1.0",
  "description": "Defied Prism CLI: add accessible React and Vue components to your project as source you own, styled with Tailwind CSS, CSS Modules or plain CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defied-labs/defied-prism.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/defied-labs/defied-prism#readme",
  "bugs": {
    "url": "https://github.com/defied-labs/defied-prism/issues"
  },
  "keywords": [
    "defied-prism",
    "cli",
    "components",
    "react",
    "vue",
    "tailwind",
    "design-system",
    "registry"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "prism": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @defied-labs/prism-core check:registry && tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@defied-labs/prism-config": "workspace:*",
    "@defied-labs/prism-core": "workspace:*",
    "@defied-labs/prism-react": "workspace:*",
    "@defied-labs/prism-style-engine": "workspace:*",
    "@defied-labs/prism-tokens": "workspace:*",
    "@defied-labs/prism-vue": "workspace:*",
    "@tailwindcss/node": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.8",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
