{
  "name": "@defied-labs/prism-react",
  "version": "0.1.0",
  "description": "Defied Prism React runtime: hooks and primitives used by generated React components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defied-labs/defied-prism.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/defied-labs/defied-prism#readme",
  "bugs": {
    "url": "https://github.com/defied-labs/defied-prism/issues"
  },
  "keywords": [
    "defied-prism",
    "react",
    "components",
    "hooks",
    "design-system"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@defied-labs/prism-core": "workspace:^"
  },
  "devDependencies": {
    "@defied-labs/prism-config": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
