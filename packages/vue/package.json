{
  "name": "@defied-labs/prism-vue",
  "version": "0.1.0",
  "description": "Defied Prism Vue runtime: composables and primitives used by generated Vue components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defied-labs/defied-prism.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/defied-labs/defied-prism#readme",
  "bugs": {
    "url": "https://github.com/defied-labs/defied-prism/issues"
  },
  "keywords": [
    "defied-prism",
    "vue",
    "components",
    "composables",
    "design-system"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@defied-labs/prism-core": "workspace:^"
  },
  "devDependencies": {
    "@defied-labs/prism-config": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "catalog:",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.8",
    "vue": "^3.5.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "vue": ">=3.4"
  }
}
