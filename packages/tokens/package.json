{
  "name": "@defied-labs/prism-tokens",
  "version": "0.1.0",
  "description": "Defied Prism design tokens: CSS variables, Tailwind theme and JSON from one source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defied-labs/defied-prism.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/defied-labs/defied-prism#readme",
  "bugs": {
    "url": "https://github.com/defied-labs/defied-prism/issues"
  },
  "keywords": [
    "defied-prism",
    "design-tokens",
    "css-variables",
    "tailwind",
    "design-system"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/build.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css",
      "./tailwind.css": "./dist/tailwind.css",
      "./tokens.json": "./dist/tokens.json"
    }
  },
  "devDependencies": {
    "@defied-labs/prism-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
