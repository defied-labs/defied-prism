{
  "metadata": {
    "name": "switch",
    "displayName": "Switch",
    "description": "An on/off toggle button (role=switch) with optional form value and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "forms",
    "keywords": [
      "switch",
      "toggle",
      "form"
    ]
  },
  "contract": {
    "element": "button",
    "slots": {
      "root": {
        "element": "button",
        "role": "switch"
      },
      "track": {
        "element": "span"
      },
      "thumb": {
        "element": "span"
      }
    },
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      "checked",
      "unchecked"
    ],
    "parts": [],
    "keyboard": [
      {
        "keys": [
          " "
        ],
        "action": "activate",
        "description": "Space toggles"
      },
      {
        "keys": [
          "Enter"
        ],
        "action": "activate",
        "description": "Enter toggles"
      }
    ],
    "aria": {
      "role": "switch",
      "attributes": [
        "aria-checked",
        "aria-invalid",
        "aria-describedby",
        "aria-required"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Switch.tsx",
            "destination": "Switch.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Switch.vue",
            "destination": "switch/Switch.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "switch/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-labs/prism-core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-labs/prism-tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.bg",
      "required": true
    },
    {
      "name": "color.border-strong",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.primary",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "duration.fast",
      "required": true
    },
    {
      "name": "easing.standard",
      "required": true
    },
    {
      "name": "focus.ring-offset",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.tight",
      "required": true
    },
    {
      "name": "opacity.disabled",
      "required": true
    },
    {
      "name": "radius.full",
      "required": true
    },
    {
      "name": "shadow.sm",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "text.md",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": true,
    "screenReaderSupport": true,
    "ariaPatterns": [
      "switch"
    ]
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/switch"
}
