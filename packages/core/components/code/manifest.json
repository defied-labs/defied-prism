{
  "metadata": {
    "name": "code",
    "displayName": "Code",
    "description": "Inline code in the monospace font on a subtle background.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "typography",
    "keywords": [
      "code",
      "typography"
    ]
  },
  "contract": {
    "element": "code",
    "props": {},
