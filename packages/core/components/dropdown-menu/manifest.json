{
  "metadata": {
    "name": "dropdown-menu",
    "displayName": "Dropdown Menu",
    "description": "A menu button (also serves as Menu): a list of actions, checkbox and radio items opened from a trigger. Roving focus with arrows, Home/End and typeahead; Escape returns focus to the trigger.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "overlays",
    "keywords": [
      "dropdown",
      "menu",
      "menu button",
      "actions",
      "context"
    ]
  },
  "contract": {
    "element": "div",
    "anchor": "content",
    "slots": {
      "root": {
        "element": "div"
      },
      "content": {
        "element": "div",
        "role": "menu"
      },
      "item": {
        "element": "div",
        "role": "menuitem"
      },
      "checkboxItem": {
        "element": "div",
        "role": "menuitemcheckbox"
      },
      "radioItem": {
        "element": "div",
        "role": "menuitemradio"
      },
      "group": {
        "element": "div",
        "role": "group"
      },
      "label": {
        "element": "div"
      },
      "separator": {
        "element": "div",
        "role": "separator"
      }
    },
    "props": {
      "align": {
        "type": "enum",
        "values": [
          "start",
          "end"
        ],
        "default": "start"
      }
    },
    "states": [
      "open",
      "closed"
    ],
    "parts": [
      "indicator"
    ],
    "keyboard": [
      {
        "keys": [
          "ArrowDown",
          "ArrowUp"
        ],
        "action": "navigate",
        "description": "Move focus to the next / previous enabled item (wraps); on the trigger, open on the first / last item"
      },
      {
        "keys": [
          "Home",
          "End"
        ],
        "action": "navigate",
        "description": "Focus the first / last enabled item"
      },
      {
        "keys": [
          "Enter"
        ],
        "action": "select",
        "description": "Activate the focused item and close; on the trigger, open"
      },
      {
        "keys": [
          " "
        ],
        "action": "select",
        "description": "Activate the focused item (checkbox and radio items stay open); on the trigger, open"
      },
      {
        "keys": [
          "Escape"
        ],
        "action": "dismiss",
        "description": "Close and return focus to the trigger"
      },
      {
        "keys": [
          "Tab"
        ],
        "action": "dismiss",
        "description": "Close; Tab moves on from the trigger, Shift+Tab focuses the trigger"
      },
      {
        "keys": [
          "a-z"
        ],
        "action": "navigate",
        "description": "Typeahead: focus the next item starting with the typed characters"
      }
    ],
    "aria": {
      "role": "menu",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/DropdownMenu.tsx",
            "destination": "DropdownMenu.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "registryDependencies": [
    "button"
  ],
  "tokens": [
    {
      "name": "color.bg",
      "required": true
    },
    {
      "name": "color.border",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.muted",
      "required": true
    },
    {
      "name": "color.muted-fg",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "duration.fast",
      "required": true
    },
    {
      "name": "easing.standard",
      "required": true
    },
    {
      "name": "focus.ring-offset",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.normal",
      "required": true
    },
    {
      "name": "opacity.disabled",
      "required": true
    },
    {
      "name": "radius.md",
      "required": true
    },
    {
      "name": "radius.sm",
      "required": true
    },
    {
      "name": "shadow.lg",
      "required": true
    },
    {
      "name": "space.1",
      "required": true
    },
    {
      "name": "space.1-5",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "space.6",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    },
    {
      "name": "text.xs",
      "required": true
    },
    {
      "name": "weight.semibold",
      "required": true
    },
    {
      "name": "z.dropdown",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": true,
    "screenReaderSupport": true,
    "ariaPatterns": [
      "menu-button",
      "menu"
    ]
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/dropdown-menu"
}
