{
  "name": "popover",
  "base": {
    "position": "relative",
    "display": "inline-flex"
  },
  "slots": {
    "content": {
      "position": "absolute",
      "zIndex": "{z.dropdown}",
      "boxSizing": "border-box",
      "width": "max-content",
      "maxWidth": "20rem",
      "padding": "{space.4}",
      "borderRadius": "{radius.md}",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "{color.border}",
      "background": "{color.bg}",
      "color": "{color.fg}",
      "boxShadow": "{shadow.md}",
      "fontFamily": "{font.sans}",
      "fontSize": "{text.sm}",
      "lineHeight": "{leading.normal}",
      "animation": "prism-roll-in {duration.normal} {easing.emphasized}",
      "_closed": {
        "pointerEvents": "none",
        "animation": "prism-roll-out {duration.fast} {easing.exit} forwards"
      },
      "_focusVisible": {
        "outline": "{focus.ring-width} solid {color.ring}",
        "outlineOffset": "{focus.ring-offset}"
      }
    }
  },
  "variants": {
    "side": {
      "top": {
        "slot:content": {
          "bottom": "100%",
          "left": "var(--prism-popover-start)",
          "right": "var(--prism-popover-end)",
          "translate": "var(--prism-popover-shift) 0",
          "marginBottom": "{space.2}",
          "transformOrigin": "bottom",
          "--prism-roll-y": "1",
          "--prism-roll-top": "100%",
          "--prism-roll-bottom": "0"
        }
      },
      "bottom": {
        "slot:content": {
          "top": "100%",
          "left": "var(--prism-popover-start)",
          "right": "var(--prism-popover-end)",
          "translate": "var(--prism-popover-shift) 0",
          "marginTop": "{space.2}",
          "transformOrigin": "top"
        }
      },
      "left": {
        "slot:content": {
          "right": "100%",
          "top": "var(--prism-popover-start)",
          "bottom": "var(--prism-popover-end)",
          "translate": "0 var(--prism-popover-shift)",
          "marginRight": "{space.2}",
          "transformOrigin": "top"
        }
      },
      "right": {
        "slot:content": {
          "left": "100%",
          "top": "var(--prism-popover-start)",
          "bottom": "var(--prism-popover-end)",
          "translate": "0 var(--prism-popover-shift)",
          "marginLeft": "{space.2}",
          "transformOrigin": "top"
        }
      }
    },
    "align": {
      "start": {
        "slot:content": {
          "--prism-popover-start": "0",
          "--prism-popover-end": "auto",
          "--prism-popover-shift": "0%"
        }
      },
      "center": {
        "slot:content": {
          "--prism-popover-start": "50%",
          "--prism-popover-end": "auto",
          "--prism-popover-shift": "-50%"
        }
      },
      "end": {
        "slot:content": {
          "--prism-popover-start": "auto",
          "--prism-popover-end": "0",
          "--prism-popover-shift": "0%"
        }
      }
    }
  },
  "defaultVariants": {
    "side": "bottom",
    "align": "center"
  }
}
