{
  "metadata": {
    "name": "popover",
    "displayName": "Popover",
    "description": "A non-modal panel anchored to a trigger. Focus moves in on open; Escape (returning focus to the trigger) or an outside click closes it, layered correctly inside dialogs.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "overlays",
    "keywords": [
      "popover",
      "popup",
      "overlay",
      "non-modal",
      "dialog"
    ]
  },
  "contract": {
    "element": "div",
    "anchor": "content",
    "slots": {
      "root": {
        "element": "div"
      },
      "content": {
        "element": "div",
        "role": "dialog"
      }
    },
    "props": {
      "side": {
        "type": "enum",
        "values": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "default": "bottom"
      },
      "align": {
        "type": "enum",
        "values": [
          "start",
          "center",
          "end"
        ],
        "default": "center"
      }
    },
    "states": [
      "open"
    ],
    "parts": [],
    "keyboard": [
      {
        "keys": [
          "Escape"
        ],
        "action": "dismiss",
        "description": "Close and return focus to the trigger"
      }
    ],
    "aria": {
      "role": "dialog",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Popover.tsx",
            "destination": "Popover.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/index.ts",
            "destination": "popover/index.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/Popover.vue",
            "destination": "popover/Popover.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/PopoverClose.vue",
            "destination": "popover/PopoverClose.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/PopoverContent.vue",
            "destination": "popover/PopoverContent.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/PopoverTrigger.vue",
            "destination": "popover/PopoverTrigger.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/context.ts",
            "destination": "popover/context.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/styles.ts",
            "destination": "popover/styles.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-labs/prism-core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-labs/prism-tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "registryDependencies": [
    "button"
  ],
