{
  "metadata": {
    "name": "table",
    "displayName": "Table",
    "description": "Semantic data table with caption, header/body/footer groups, density and striped variants, and a horizontal scroll container that becomes a named, focusable region when it overflows.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "data-display",
    "keywords": [
      "table",
      "data",
      "grid"
    ]
  },
  "contract": {
    "element": "table",
    "slots": {
      "root": {
        "element": "table"
      },
      "scroll": {
        "element": "div"
      },
      "caption": {
        "element": "caption"
      },
      "header": {
        "element": "thead"
      },
      "body": {
        "element": "tbody"
      },
      "footer": {
        "element": "tfoot"
      },
      "row": {
        "element": "tr"
      },
      "head": {
        "element": "th"
      },
      "cell": {
        "element": "td"
      }
    },
    "props": {
      "density": {
        "type": "enum",
        "values": [
          "compact",
          "normal",
          "relaxed"
        ],
        "default": "normal"
      },
      "striped": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "table",
      "attributes": []
    }
  },
