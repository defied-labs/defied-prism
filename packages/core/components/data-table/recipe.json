{
  "name": "data-table",
  "base": {},
  "slots": {
    "scroll": {},
    "caption": {
      "captionSide": "top",
      "marginTop": "0",
      "paddingBlock": "{space.2}"
    },
    "headerCell": {
      "borderBottomColor": "{color.border-strong}"
    },
    "sortButton": {
      "part:sort-icon": {
        "fontSize": "{text.xs}",
        "color": "{color.muted-fg}"
      }
    },
    "row": {
      "_selected": {
        "background": "{color.muted}"
      }
    },
    "cell": {},
    "rowHeader": {
      "fontWeight": "{weight.medium}",
      "color": "{color.fg}",
      "whiteSpace": "normal"
    },
    "checkbox": {}
  },
  "variants": {
    "size": {
      "sm": {},
      "md": {}
    }
  },
  "defaultVariants": {
    "size": "md"
  }
}
