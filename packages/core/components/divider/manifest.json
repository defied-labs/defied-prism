{
  "metadata": {
    "name": "divider",
    "displayName": "Divider",
    "description": "Horizontal or vertical separator, semantic or decorative.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "layout",
    "keywords": [
      "divider",
      "layout"
    ]
  },
  "contract": {
    "element": "hr",
    "props": {
      "orientation": {
        "type": "enum",
        "values": [
          "horizontal",
          "vertical"
        ],
        "default": "horizontal"
      },
      "decorative": {
        "type": "boolean",
        "default": false,
        "description": "Purely visual: removed from the accessibility tree."
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "separator",
      "attributes": [
        "aria-orientation",
        "aria-hidden"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Divider.tsx",
            "destination": "Divider.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Divider.vue",
            "destination": "divider/Divider.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "divider/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.border",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": false,
    "screenReaderSupport": true,
    "ariaPatterns": []
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/divider"
}
