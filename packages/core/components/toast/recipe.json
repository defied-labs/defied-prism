{
  "name": "toast",
  "base": {
    "position": "fixed",
    "zIndex": "{z.toast}",
    "display": "flex",
    "gap": "{space.2}",
    "width": "max-content",
    "maxWidth": "calc(100vw - 2rem)",
    "margin": "0",
    "padding": "0",
    "pointerEvents": "none",
    "fontFamily": "{font.sans}"
  },
  "slots": {
    "item": {
      "display": "grid",
      "gridTemplateRows": "1fr",
      "animation": "prism-slide-in {duration.normal} {easing.emphasized}",
      "transition": "grid-template-rows {duration.normal} {easing.exit}, margin {duration.normal} {easing.exit}",
      "_closed": {
        "gridTemplateRows": "0fr",
        "marginBlockStart": "calc(-1 * {space.2})",
        "--prism-toast-events": "none",
        "animation": "prism-slide-out {duration.normal} {easing.exit} forwards, prism-fade-out {duration.normal} {easing.exit} forwards"
      }
    },
    "toast": {
      "position": "relative",
      "overflow": "hidden",
      "minHeight": "0",
      "display": "flex",
      "alignItems": "flex-start",
      "gap": "{space.3}",
      "width": "22rem",
      "maxWidth": "100%",
      "paddingBlock": "{space.3}",
      "paddingInline": "{space.4}",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderRadius": "{radius.lg}",
      "boxShadow": "{shadow.lg}",
      "fontSize": "{text.sm}",
      "lineHeight": "{leading.normal}",
      "pointerEvents": "var(--prism-toast-events, auto)",
      "animation": "prism-scale-in {duration.normal} {easing.emphasized}",
      "_focusVisible": {
        "outline": "{focus.ring-width} solid {color.ring}",
        "outlineOffset": "{focus.ring-offset}"
      }
    },
    "content": {
      "display": "flex",
      "flexDirection": "column",
      "gap": "{space.1}",
      "flexGrow": "1",
      "minWidth": "0"
    },
    "title": {
      "fontWeight": "{weight.semibold}",
      "lineHeight": "{leading.tight}"
    },
    "description": {
      "color": "inherit"
    },
    "progress": {
      "position": "absolute",
      "insetInlineStart": "0",
      "insetInlineEnd": "0",
      "bottom": "0",
      "height": "2px",
      "background": "currentColor",
      "opacity": "0.4",
      "transformOrigin": "left",
      "animationName": "prism-countdown",
      "animationTimingFunction": "linear",
      "animationFillMode": "forwards"
    },
    "action": {
      "flexShrink": "0"
    },
    "close": {
      "flexShrink": "0"
    }
  },
  "variants": {
    "position": {
      "top-start": {
        "top": "{space.4}",
        "bottom": "auto",
        "insetInlineStart": "{space.4}",
        "insetInlineEnd": "auto",
        "transform": "none",
        "flexDirection": "column-reverse",
        "slot:item": {
          "--prism-slide-x": "calc(-100% - 1rem)",
          "--prism-slide-y": "0"
        }
      },
      "top-center": {
        "top": "{space.4}",
        "bottom": "auto",
        "insetInlineStart": "50%",
        "insetInlineEnd": "auto",
        "transform": "translateX(-50%)",
        "flexDirection": "column-reverse",
        "slot:item": {
          "--prism-slide-x": "0",
          "--prism-slide-y": "calc(-100% - 1rem)"
        }
      },
      "top-end": {
        "top": "{space.4}",
        "bottom": "auto",
        "insetInlineStart": "auto",
        "insetInlineEnd": "{space.4}",
        "transform": "none",
        "flexDirection": "column-reverse",
        "slot:item": {
          "--prism-slide-x": "calc(100% + 1rem)",
          "--prism-slide-y": "0"
        }
      },
      "bottom-start": {
        "top": "auto",
        "bottom": "{space.4}",
        "insetInlineStart": "{space.4}",
        "insetInlineEnd": "auto",
        "transform": "none",
        "flexDirection": "column",
        "slot:item": {
          "--prism-slide-x": "calc(-100% - 1rem)",
          "--prism-slide-y": "0"
        }
      },
      "bottom-center": {
        "top": "auto",
        "bottom": "{space.4}",
        "insetInlineStart": "50%",
        "insetInlineEnd": "auto",
        "transform": "translateX(-50%)",
        "flexDirection": "column",
        "slot:item": {
          "--prism-slide-x": "0",
          "--prism-slide-y": "calc(100% + 1rem)"
        }
      },
      "bottom-end": {
        "top": "auto",
        "bottom": "{space.4}",
        "insetInlineStart": "auto",
        "insetInlineEnd": "{space.4}",
        "transform": "none",
        "flexDirection": "column",
        "slot:item": {
          "--prism-slide-x": "calc(100% + 1rem)",
          "--prism-slide-y": "0"
        }
      }
    },
    "status": {
      "neutral": {
        "slot:toast": {
          "background": "{color.neutral-bg}",
          "color": "{color.neutral-fg}",
          "borderColor": "{color.neutral-border}"
        }
      },
      "info": {
        "slot:toast": {
          "background": "{color.info-bg}",
          "color": "{color.info-fg}",
          "borderColor": "{color.info-border}"
        }
      },
      "success": {
        "slot:toast": {
          "background": "{color.success-bg}",
          "color": "{color.success-fg}",
          "borderColor": "{color.success-border}"
        }
      },
      "warning": {
        "slot:toast": {
          "background": "{color.warning-bg}",
          "color": "{color.warning-fg}",
          "borderColor": "{color.warning-border}"
        }
      },
      "danger": {
        "slot:toast": {
          "background": "{color.danger-bg}",
          "color": "{color.danger-fg}",
          "borderColor": "{color.danger-border}"
        }
      }
    }
  },
  "defaultVariants": {
    "position": "bottom-end",
    "status": "neutral"
  }
}
