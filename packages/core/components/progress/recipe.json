{
  "name": "progress",
  "base": {
    "position": "relative",
    "display": "block",
    "width": "100%",
    "overflow": "hidden",
    "borderRadius": "{radius.full}",
    "background": "{color.muted}"
  },
  "slots": {
    "indicator": {
      "display": "block",
      "height": "100%",
      "borderRadius": "inherit",
      "transition": "width {duration.normal} {easing.standard}"
    }
  },
  "variants": {
    "status": {
      "neutral": {
        "slot:indicator": {
          "background": "{color.neutral-solid}"
        }
      },
      "info": {
        "slot:indicator": {
          "background": "{color.info-solid}"
        }
      },
      "success": {
        "slot:indicator": {
          "background": "{color.success-solid}"
        }
      },
      "warning": {
        "slot:indicator": {
          "background": "{color.warning-solid}"
        }
      },
      "danger": {
        "slot:indicator": {
          "background": "{color.danger-solid}"
        }
      }
    },
    "size": {
      "sm": {
        "height": "{space.1}"
      },
      "md": {
        "height": "{space.2}"
      },
      "lg": {
        "height": "{space.3}"
      }
    },
    "indeterminate": {
      "true": {
        "slot:indicator": {
          "animation": "prism-indeterminate calc({duration.slow} * 4) {easing.standard} infinite"
        }
      }
    }
  },
  "defaultVariants": {
    "status": "info",
    "size": "md"
  }
}
