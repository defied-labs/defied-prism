{
  "metadata": {
    "name": "text",
    "displayName": "Text",
    "description": "Body text with size, tone, weight and truncation.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "typography",
    "keywords": [
      "text",
      "typography"
    ]
  },
  "contract": {
    "element": "p",
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "lg",
          "md",
          "sm",
          "xs"
        ],
        "default": "md"
      },
      "tone": {
        "type": "enum",
        "values": [
          "body",
          "lead",
          "muted",
          "success",
          "warning",
          "danger"
        ],
        "default": "body"
      },
      "weight": {
        "type": "enum",
        "values": [
          "regular",
          "medium",
          "semibold",
          "bold"
        ],
        "default": "regular"
      },
      "truncate": {
        "type": "boolean",
        "default": false,
        "description": "Single line with an ellipsis."
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "paragraph",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Text.tsx",
            "destination": "Text.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.danger-fg",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.muted-fg",
      "required": true
    },
    {
      "name": "color.success-fg",
      "required": true
    },
    {
      "name": "color.warning-fg",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.normal",
      "required": true
    },
    {
      "name": "text.lg",
      "required": true
    },
    {
      "name": "text.md",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    },
    {
      "name": "text.xs",
      "required": true
    },
    {
      "name": "weight.bold",
      "required": true
    },
    {
      "name": "weight.medium",
      "required": true
    },
    {
      "name": "weight.regular",
      "required": true
    },
    {
      "name": "weight.semibold",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": false,
    "screenReaderSupport": true,
    "ariaPatterns": []
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/text"
}
