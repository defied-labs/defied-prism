{
  "metadata": {
    "name": "alert",
    "displayName": "Alert",
    "description": "An inline status message with optional title, icon, action and dismiss button. role=status by default; urgent alerts use role=alert.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "feedback",
    "keywords": [
      "alert",
      "callout",
      "banner",
      "status"
    ]
  },
  "contract": {
    "element": "div",
    "slots": {
      "root": {
        "element": "div",
        "role": "status"
      },
      "icon": {
        "element": "span",
        "optional": true
      },
      "content": {
        "element": "div"
      },
      "title": {
        "element": "div"
      },
      "description": {
        "element": "div"
      },
      "action": {
        "element": "div",
        "optional": true
      },
      "close": {
        "element": "button",
        "optional": true
      }
    },
    "props": {
      "status": {
        "type": "enum",
        "values": [
          "neutral",
          "info",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral"
      },
      "urgent": {
        "type": "boolean",
        "default": false,
        "description": "Use role=alert (assertive) for important, time-sensitive messages. Default role=status (polite)."
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "status",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Alert.tsx",
            "destination": "Alert.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "registryDependencies": [
    "icon-button"
  ],
  "tokens": [
    {
      "name": "color.danger-bg",
      "required": true
    },
    {
      "name": "color.danger-border",
      "required": true
    },
    {
