{
  "metadata": {
    "name": "badge",
    "displayName": "Badge",
    "description": "A small, non-interactive status label.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "data-display",
    "keywords": [
      "badge",
      "tag",
      "label",
      "status"
    ]
  },
  "contract": {
    "element": "span",
    "props": {
      "status": {
        "type": "enum",
        "values": [
          "neutral",
          "info",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral"
      },
      "variant": {
        "type": "enum",
        "values": [
          "subtle",
          "solid",
          "outline"
        ],
        "default": "subtle"
      },
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      }
    },
    "states": [],
    "parts": [
      "icon"
    ],
    "keyboard": [],
    "aria": {
      "role": "generic",
      "attributes": []
    }
  },
