{
  "metadata": {
    "name": "box",
    "displayName": "Box",
    "description": "Generic layout element with a typed `as` prop and token-based padding and background.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "layout",
    "keywords": [
      "box",
      "layout"
    ]
  },
  "contract": {
    "element": "div",
    "props": {
      "padding": {
        "type": "enum",
        "values": [
          "none",
          "sm",
          "md",
          "lg"
        ],
        "default": "none"
      },
      "background": {
        "type": "enum",
        "values": [
          "none",
          "subtle",
          "muted"
        ],
        "default": "none"
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "generic",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Box.tsx",
            "destination": "Box.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Box.vue",
            "destination": "box/Box.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "box/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-labs/prism-core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-labs/prism-tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.bg-subtle",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.muted",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "space.4",
      "required": true
    },
    {
      "name": "space.6",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": false,
    "screenReaderSupport": true,
    "ariaPatterns": []
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/box"
}
