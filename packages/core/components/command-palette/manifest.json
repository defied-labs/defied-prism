{
  "metadata": {
    "name": "command-palette",
    "displayName": "Command Palette",
    "description": "A modal command palette: compound input, list, groups and items (registered through context) with filtering, keyboard navigation, an empty state and an optional global shortcut.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "overlays",
    "keywords": [
      "command",
      "palette",
      "cmdk",
      "search",
      "launcher"
    ]
  },
  "contract": {
    "element": "div",
    "anchor": "content",
    "slots": {
      "overlay": {
        "element": "div"
      },
      "content": {
        "element": "div",
        "role": "dialog"
      },
      "input": {
        "element": "input",
        "role": "combobox"
      },
      "listbox": {
        "element": "div",
        "role": "listbox"
      },
      "group": {
        "element": "div",
        "role": "group"
      },
      "groupLabel": {
        "element": "div"
      },
      "item": {
        "element": "div",
        "role": "option"
      },
      "separator": {
        "element": "div",
        "optional": true
      },
      "empty": {
        "element": "div",
        "role": "status",
        "optional": true
      }
    },
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md",
          "lg"
        ],
        "default": "md"
      }
    },
    "states": [
      "open"
    ],
    "parts": [],
    "keyboard": [
      {
        "keys": [
          "ArrowDown",
          "ArrowUp"
        ],
        "action": "navigate",
        "description": "Highlight the next / previous command, wrapping"
      },
      {
        "keys": [
          "Home",
          "End"
        ],
        "action": "navigate",
        "description": "Highlight the first / last command"
      },
      {
        "keys": [
          "Enter"
        ],
        "action": "select",
        "description": "Run the highlighted command"
      },
      {
        "keys": [
          "Escape"
        ],
        "action": "dismiss",
        "description": "Close the palette"
      }
    ],
    "aria": {
      "role": "dialog",
      "attributes": [
        "aria-modal"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/CommandPalette.tsx",
            "destination": "CommandPalette.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "react-dom",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/index.ts",
            "destination": "command-palette/index.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CommandPalette.vue",
            "destination": "command-palette/CommandPalette.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CommandInput.vue",
            "destination": "command-palette/CommandInput.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CommandList.vue",
            "destination": "command-palette/CommandList.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CommandEmpty.vue",
            "destination": "command-palette/CommandEmpty.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CommandGroup.vue",
            "destination": "command-palette/CommandGroup.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CommandItem.vue",
            "destination": "command-palette/CommandItem.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CommandSeparator.vue",
            "destination": "command-palette/CommandSeparator.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/context.ts",
            "destination": "command-palette/context.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/styles.ts",
            "destination": "command-palette/styles.ts",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/vue",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
