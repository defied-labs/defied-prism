{
  "name": "command-palette",
  "base": {},
  "slots": {
    "overlay": {
      "position": "fixed",
      "inset": "0",
      "zIndex": "{z.overlay}",
      "background": "{color.overlay}",
      "animation": "prism-fade-in {duration.normal} {easing.standard}"
    },
    "content": {
      "position": "fixed",
      "zIndex": "{z.modal}",
      "top": "15vh",
      "left": "50%",
      "transform": "translateX(-50%)",
      "boxSizing": "border-box",
      "width": "calc(100vw - 2 * {space.4})",
      "maxHeight": "70vh",
      "display": "flex",
      "flexDirection": "column",
      "overflow": "hidden",
      "borderRadius": "{radius.lg}",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "{color.border}",
      "background": "{color.bg}",
      "color": "{color.fg}",
      "boxShadow": "{shadow.lg}",
      "fontFamily": "{font.sans}",
      "animation": "prism-scale-in {duration.normal} {easing.emphasized}",
      "_focusVisible": {
        "outline": "{focus.ring-width} solid {color.ring}",
        "outlineOffset": "{focus.ring-offset}"
      }
    },
    "input": {
      "boxSizing": "border-box",
      "width": "100%",
      "minHeight": "{control.lg}",
      "paddingInline": "{space.4}",
      "borderWidth": "0 0 1px 0",
      "borderStyle": "solid",
      "borderColor": "{color.border}",
      "background": "transparent",
      "color": "{color.fg}",
      "fontFamily": "inherit",
      "fontSize": "{text.md}",
      "lineHeight": "{leading.normal}",
      "_placeholder": {
        "color": "{color.muted-fg}"
      },
      "_focusVisible": {
        "outline": "none"
      }
    },
    "listbox": {
      "overflowY": "auto",
      "padding": "{space.1}"
    },
    "group": {
      "paddingBlock": "{space.1}"
    },
    "groupLabel": {
      "paddingBlock": "{space.1}",
      "paddingInline": "{space.2}",
      "color": "{color.muted-fg}",
      "fontSize": "{text.xs}",
      "fontWeight": "{weight.medium}"
    },
    "item": {
      "display": "flex",
      "alignItems": "center",
      "gap": "{space.2}",
      "paddingBlock": "{space.2}",
      "paddingInline": "{space.2}",
      "borderRadius": "{radius.sm}",
      "fontSize": "{text.sm}",
      "cursor": "pointer",
      "userSelect": "none",
      "_highlighted": {
        "background": "{color.muted}"
      },
      "_ariaDisabled": {
        "opacity": "{opacity.disabled}",
        "cursor": "not-allowed"
      }
    },
    "separator": {
      "height": "1px",
      "marginBlock": "{space.1}",
      "marginInline": "calc(-1 * {space.1})",
      "background": "{color.border}"
    },
    "empty": {
      "padding": "{space.6}",
      "textAlign": "center",
      "color": "{color.muted-fg}",
      "fontSize": "{text.sm}"
    }
  },
  "variants": {
    "size": {
      "sm": {
        "slot:content": {
          "maxWidth": "28rem"
        }
      },
      "md": {
        "slot:content": {
          "maxWidth": "36rem"
        }
      },
      "lg": {
        "slot:content": {
          "maxWidth": "48rem"
        }
      }
    }
  },
  "defaultVariants": {
    "size": "md"
  }
}
