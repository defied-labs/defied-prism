{
  "name": "drawer",
  "base": {},
  "slots": {
    "overlay": {
      "position": "fixed",
      "inset": "0",
      "zIndex": "{z.overlay}",
      "background": "{color.overlay}",
      "animation": "prism-fade-in {duration.normal} {easing.standard}"
    },
    "content": {
      "position": "fixed",
      "zIndex": "{z.modal}",
      "boxSizing": "border-box",
      "overflowY": "auto",
      "display": "flex",
      "flexDirection": "column",
      "gap": "{space.4}",
      "padding": "{space.6}",
      "borderStyle": "solid",
      "borderColor": "{color.border}",
      "background": "{color.bg}",
      "color": "{color.fg}",
      "boxShadow": "{shadow.lg}",
      "fontFamily": "{font.sans}",
      "animation": "prism-slide-in {duration.normal} {easing.emphasized}",
      "_focusVisible": {
        "outline": "{focus.ring-width} solid {color.ring}",
        "outlineOffset": "calc(-1 * {focus.ring-width})"
      }
    },
    "title": {
      "margin": "0",
      "fontSize": "{text.lg}",
      "fontWeight": "{weight.semibold}",
      "lineHeight": "{leading.tight}"
    },
    "description": {
      "margin": "0",
      "color": "{color.muted-fg}",
      "fontSize": "{text.sm}",
      "lineHeight": "{leading.normal}"
    },
    "footer": {
      "display": "flex",
      "flexWrap": "wrap",
      "justifyContent": "flex-end",
      "gap": "{space.2}",
      "marginTop": "auto"
    }
  },
  "variants": {
    "side": {
      "left": {
        "slot:content": {
          "--prism-slide-x": "-100%",
          "inset": "0 auto 0 0",
          "width": "var(--prism-drawer-size)",
          "maxWidth": "100vw",
          "borderWidth": "0 1px 0 0"
        }
      },
      "right": {
        "slot:content": {
          "--prism-slide-x": "100%",
          "inset": "0 0 0 auto",
          "width": "var(--prism-drawer-size)",
          "maxWidth": "100vw",
          "borderWidth": "0 0 0 1px"
        }
      },
      "top": {
        "slot:content": {
          "--prism-slide-y": "-100%",
          "inset": "0 0 auto 0",
          "height": "var(--prism-drawer-size)",
          "maxHeight": "100dvh",
          "borderWidth": "0 0 1px 0"
        }
      },
      "bottom": {
        "slot:content": {
          "--prism-slide-y": "100%",
          "inset": "auto 0 0 0",
          "height": "var(--prism-drawer-size)",
          "maxHeight": "100dvh",
          "borderWidth": "1px 0 0 0"
        }
      }
    },
    "size": {
      "sm": {
        "slot:content": {
          "--prism-drawer-size": "20rem"
        }
      },
      "md": {
        "slot:content": {
          "--prism-drawer-size": "24rem"
        }
      },
      "lg": {
        "slot:content": {
          "--prism-drawer-size": "32rem"
        }
      },
      "full": {
        "slot:content": {
          "--prism-drawer-size": "100%"
        }
      }
    }
  },
  "defaultVariants": {
    "side": "right",
    "size": "md"
  }
}
