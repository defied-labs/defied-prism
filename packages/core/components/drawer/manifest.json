{
  "metadata": {
    "name": "drawer",
    "displayName": "Drawer",
    "description": "A modal side sheet anchored to a viewport edge: focus trapped and restored, background inert, scroll locked, dismissable with Escape or an outside click.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "overlays",
    "keywords": [
      "drawer",
      "sheet",
      "side panel",
      "modal",
      "overlay"
    ]
  },
  "contract": {
    "element": "div",
    "anchor": "content",
    "slots": {
      "overlay": {
        "element": "div"
      },
      "content": {
        "element": "div",
        "role": "dialog"
      },
      "title": {
        "element": "h2"
      },
      "description": {
        "element": "p"
      },
      "footer": {
        "element": "div"
      }
    },
    "props": {
      "side": {
        "type": "enum",
        "values": [
          "left",
          "right",
          "top",
          "bottom"
        ],
        "default": "right"
      },
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md",
          "lg",
          "full"
        ],
        "default": "md"
      },
      "closeOnOutsideClick": {
        "type": "boolean",
        "default": true
      },
      "closeOnEscape": {
        "type": "boolean",
        "default": true
      }
    },
    "states": [
      "open"
    ],
    "parts": [],
    "keyboard": [
      {
        "keys": [
          "Escape"
        ],
        "action": "dismiss"
      },
      {
        "keys": [
          "Tab"
        ],
        "action": "navigate",
        "description": "Cycles through focusable elements inside the drawer only"
      }
    ],
    "aria": {
      "role": "dialog",
      "attributes": [
        "aria-modal",
        "aria-labelledby",
        "aria-describedby"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Drawer.tsx",
            "destination": "Drawer.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "react-dom",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/index.ts",
            "destination": "drawer/index.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/Drawer.vue",
