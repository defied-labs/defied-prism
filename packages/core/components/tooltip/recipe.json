{
  "name": "tooltip",
  "base": {
    "position": "relative",
    "display": "inline-flex"
  },
  "slots": {
    "content": {
      "position": "absolute",
      "zIndex": "{z.tooltip}",
      "width": "max-content",
      "maxWidth": "20rem",
      "paddingBlock": "{space.1}",
      "paddingInline": "{space.2}",
      "borderRadius": "{radius.md}",
      "background": "{color.inverse}",
      "color": "{color.inverse-fg}",
      "boxShadow": "{shadow.md}",
      "fontFamily": "{font.sans}",
      "fontSize": "{text.xs}",
      "lineHeight": "{leading.snug}",
      "--prism-zoom-scale": "0.92",
      "animation": "prism-zoom-in {duration.normal} {easing.emphasized}",
      "_closed": {
        "pointerEvents": "none",
        "animation": "prism-zoom-out {duration.fast} {easing.exit} forwards"
      }
    }
  },
  "variants": {
    "side": {
      "top": {
        "slot:content": {
          "bottom": "100%",
          "left": "50%",
          "translate": "-50% 0",
          "marginBottom": "{space.2}",
          "transformOrigin": "bottom",
          "--prism-zoom-y": "-0.25rem"
        }
      },
      "bottom": {
        "slot:content": {
          "top": "100%",
          "left": "50%",
          "translate": "-50% 0",
          "marginTop": "{space.2}",
          "transformOrigin": "top",
          "--prism-zoom-y": "0.25rem"
        }
      },
      "left": {
        "slot:content": {
          "right": "100%",
          "top": "50%",
          "translate": "0 -50%",
          "marginRight": "{space.2}",
          "transformOrigin": "right",
          "--prism-zoom-x": "-0.25rem"
        }
      },
      "right": {
        "slot:content": {
          "left": "100%",
          "top": "50%",
          "translate": "0 -50%",
          "marginLeft": "{space.2}",
          "transformOrigin": "left",
          "--prism-zoom-x": "0.25rem"
        }
      }
    }
  },
  "defaultVariants": {
    "side": "top"
  }
}
