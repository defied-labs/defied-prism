{
  "name": "skeleton",
  "base": {
    "display": "flex",
    "flexDirection": "column",
    "gap": "{space.2}"
  },
  "slots": {
    "shape": {
      "display": "block",
      "background": "{color.muted}",
      "animation": "prism-pulse calc({duration.slow} * 5) {easing.standard} infinite"
    },
    "label": {
      "position": "absolute",
      "width": "1px",
      "height": "1px",
      "padding": "0",
      "margin": "-1px",
      "overflow": "hidden",
      "clip": "rect(0, 0, 0, 0)",
      "whiteSpace": "nowrap",
      "borderWidth": "0"
    }
  },
  "variants": {
    "variant": {
      "text": {
        "slot:shape": {
          "width": "100%",
          "height": "1em",
          "borderRadius": "{radius.sm}"
        }
      },
      "rect": {
        "slot:shape": {
          "width": "100%",
          "height": "6rem",
          "borderRadius": "{radius.md}"
        }
      },
      "circle": {
        "slot:shape": {
          "width": "{control.md}",
          "height": "{control.md}",
          "borderRadius": "{radius.full}"
        }
      }
    }
  },
  "defaultVariants": {
    "variant": "text"
  }
}
