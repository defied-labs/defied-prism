{
  "metadata": {
    "name": "card",
    "displayName": "Card",
    "description": "Grouped content panel with header, title, description, content and footer. Optional interactive variant uses a single primary link (block-link pattern) so the card never nests interactive elements.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "layout",
    "keywords": [
      "card",
      "panel",
      "tile"
    ]
  },
  "contract": {
    "element": "div",
    "slots": {
      "root": {
        "element": "div"
      },
      "header": {
        "element": "div"
      },
      "title": {
        "element": "h3"
      },
      "description": {
        "element": "p"
      },
      "content": {
        "element": "div"
      },
      "footer": {
        "element": "div"
      },
      "link": {
        "element": "a",
        "optional": true
      }
    },
    "props": {
      "variant": {
        "type": "enum",
        "values": [
          "flat",
          "raised",
          "outlined"
        ],
        "default": "outlined"
      },
      "interactive": {
        "type": "boolean",
        "default": false,
        "description": "Clicking non-interactive card area activates the CardLink. Only the link is focusable."
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "generic",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Card.tsx",
            "destination": "Card.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.bg",
      "required": true
    },
    {
      "name": "color.border",
      "required": true
    },
    {
      "name": "color.border-strong",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.muted-fg",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "duration.fast",
      "required": true
    },
    {
      "name": "easing.standard",
      "required": true
    },
    {
      "name": "focus.ring-offset",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.normal",
      "required": true
    },
    {
      "name": "leading.tight",
      "required": true
    },
    {
      "name": "radius.lg",
      "required": true
    },
    {
      "name": "radius.sm",
      "required": true
    },
    {
      "name": "shadow.md",
      "required": true
    },
    {
      "name": "space.1-5",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "space.4",
      "required": true
    },
    {
      "name": "space.6",
      "required": true
    },
    {
      "name": "text.lg",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    },
    {
      "name": "weight.semibold",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": false,
    "screenReaderSupport": true,
    "ariaPatterns": []
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/card"
}
