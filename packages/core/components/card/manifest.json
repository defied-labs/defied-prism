{
  "metadata": {
    "name": "card",
    "displayName": "Card",
    "description": "Grouped content panel with header, title, description, content and footer. Optional interactive variant uses a single primary link (block-link pattern) so the card never nests interactive elements.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "layout",
    "keywords": [
      "card",
      "panel",
      "tile"
    ]
  },
  "contract": {
    "element": "div",
    "slots": {
      "root": {
        "element": "div"
      },
      "header": {
        "element": "div"
      },
      "title": {
        "element": "h3"
      },
      "description": {
        "element": "p"
      },
      "content": {
        "element": "div"
      },
      "footer": {
        "element": "div"
      },
      "link": {
        "element": "a",
        "optional": true
      }
    },
    "props": {
      "variant": {
        "type": "enum",
        "values": [
          "flat",
          "raised",
          "outlined"
        ],
        "default": "outlined"
      },
      "interactive": {
        "type": "boolean",
        "default": false,
        "description": "Clicking non-interactive card area activates the CardLink. Only the link is focusable."
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "generic",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Card.tsx",
            "destination": "Card.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Card.vue",
            "destination": "card/Card.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CardContent.vue",
            "destination": "card/CardContent.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CardDescription.vue",
            "destination": "card/CardDescription.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CardFooter.vue",
            "destination": "card/CardFooter.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CardHeader.vue",
            "destination": "card/CardHeader.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CardLink.vue",
            "destination": "card/CardLink.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/CardTitle.vue",
            "destination": "card/CardTitle.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/context.ts",
            "destination": "card/context.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/styles.ts",
            "destination": "card/styles.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "card/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-labs/prism-core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-labs/prism-tokens",
