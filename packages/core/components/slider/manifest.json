{
  "metadata": {
    "name": "slider",
    "displayName": "Slider",
    "description": "A single-value slider with keyboard, pointer drag, orientation, form value and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "forms",
    "keywords": [
      "slider",
      "range",
      "form"
    ]
  },
  "contract": {
    "element": "div",
    "slots": {
      "root": {
        "element": "div",
        "role": "slider"
      },
      "track": {
        "element": "span"
      },
      "range": {
        "element": "span"
      }
    },
    "props": {
      "orientation": {
        "type": "enum",
        "values": [
          "horizontal",
          "vertical"
        ],
        "default": "horizontal"
      },
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [],
    "parts": [
      "thumb"
    ],
    "keyboard": [
      {
        "keys": [
          "ArrowRight",
          "ArrowUp"
        ],
        "action": "increment",
        "description": "Increase by one step"
      },
      {
        "keys": [
          "ArrowLeft",
          "ArrowDown"
        ],
        "action": "decrement",
        "description": "Decrease by one step"
      },
      {
        "keys": [
          "PageUp",
          "PageDown"
        ],
        "action": "increment",
        "description": "Increase / decrease by ten steps"
      },
      {
        "keys": [
          "Home",
          "End"
        ],
        "action": "navigate",
        "description": "Minimum / maximum"
      }
    ],
    "aria": {
      "role": "slider",
      "attributes": [
        "aria-valuemin",
        "aria-valuemax",
        "aria-valuenow",
        "aria-valuetext",
        "aria-orientation",
        "aria-disabled",
        "aria-invalid",
        "aria-describedby"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Slider.tsx",
            "destination": "Slider.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.bg",
      "required": true
    },
    {
      "name": "color.muted",
      "required": true
    },
    {
      "name": "color.primary",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "focus.ring-offset",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "opacity.disabled",
      "required": true
    },
    {
      "name": "radius.full",
      "required": true
    },
    {
      "name": "shadow.sm",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": true,
    "screenReaderSupport": true,
    "ariaPatterns": [
      "slider"
    ]
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/slider"
}
