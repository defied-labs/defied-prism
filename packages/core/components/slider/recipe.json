{
  "name": "slider",
  "base": {
    "position": "relative",
    "display": "flex",
    "alignItems": "center",
    "justifyContent": "center",
    "boxSizing": "border-box",
    "flexShrink": "0",
    "touchAction": "none",
    "userSelect": "none",
    "cursor": "pointer",
    "_focusVisible": {
      "outline": "none",
      "part:thumb": {
        "outline": "{focus.ring-width} solid {color.ring}",
        "outlineOffset": "{focus.ring-offset}"
      }
    },
    "_ariaDisabled": {
      "opacity": "{opacity.disabled}",
      "cursor": "not-allowed"
    },
    "part:thumb": {
      "position": "absolute",
      "boxSizing": "border-box",
      "width": "var(--prism-slider-thumb)",
      "height": "var(--prism-slider-thumb)",
      "borderRadius": "{radius.full}",
      "borderWidth": "2px",
      "borderStyle": "solid",
      "borderColor": "{color.primary}",
      "background": "{color.bg}",
      "boxShadow": "{shadow.sm}",
      "pointerEvents": "none"
    }
  },
  "slots": {
    "track": {
      "position": "relative",
      "flexGrow": "1",
      "alignSelf": "stretch",
      "overflow": "hidden",
      "borderRadius": "{radius.full}",
      "background": "{color.muted}"
    },
    "range": {
      "position": "absolute",
      "background": "{color.primary}"
    }
  },
  "variants": {
    "orientation": {
      "horizontal": {
        "flexDirection": "row",
        "width": "100%",
        "minWidth": "8rem",
        "height": "var(--prism-slider-thumb)",
        "paddingBlock": "calc((var(--prism-slider-thumb) - var(--prism-slider-track)) / 2)",
        "paddingInline": "0",
        "slot:range": {
          "top": "0",
          "bottom": "0",
          "left": "0",
          "width": "calc(var(--prism-slider-fraction, 0) * 100%)",
          "height": "auto"
        },
        "part:thumb": {
          "left": "calc(var(--prism-slider-fraction, 0) * (100% - var(--prism-slider-thumb)))",
          "top": "0"
        }
      },
      "vertical": {
        "flexDirection": "column",
        "width": "var(--prism-slider-thumb)",
        "minWidth": "0",
        "height": "8rem",
        "paddingInline": "calc((var(--prism-slider-thumb) - var(--prism-slider-track)) / 2)",
        "paddingBlock": "0",
        "slot:range": {
          "left": "0",
          "right": "0",
          "bottom": "0",
          "height": "calc(var(--prism-slider-fraction, 0) * 100%)",
          "width": "auto"
        },
        "part:thumb": {
          "top": "calc((1 - var(--prism-slider-fraction, 0)) * (100% - var(--prism-slider-thumb)))",
          "left": "0"
        }
      }
    },
    "size": {
      "sm": {
        "--prism-slider-thumb": "1rem",
        "--prism-slider-track": "0.25rem"
      },
      "md": {
        "--prism-slider-thumb": "1.25rem",
        "--prism-slider-track": "0.375rem"
      }
    }
  },
  "defaultVariants": {
    "orientation": "horizontal",
    "size": "md"
  }
}
