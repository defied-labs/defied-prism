{
  "metadata": {
    "name": "button",
    "displayName": "Button",
    "description": "A versatile button component with state-driven interactions",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "stable",
    "category": "actions",
    "keywords": [
      "button",
      "action",
      "interactive",
      "form"
    ]
  },
  "contract": {
    "element": "button",
    "props": {
      "variant": {
        "type": "enum",
        "values": [
          "primary",
          "secondary",
          "outline",
          "ghost",
          "destructive",
          "link"
        ],
        "default": "primary"
      },
      "size": {
        "type": "enum",
        "values": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ],
        "default": "md"
      },
      "fullWidth": {
        "type": "boolean",
        "default": false
      },
      "loading": {
        "type": "boolean",
        "default": false,
        "description": "Shows a spinner, sets aria-busy and aria-disabled, keeps focus, and ignores activation."
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      "idle",
      "focused",
      "pressed",
      "disabled",
      "loading"
    ],
    "parts": [
      "icon",
      "spinner"
    ],
    "keyboard": [
      {
        "keys": [
          "Enter"
        ],
        "action": "activate"
      },
      {
        "keys": [
          " "
        ],
        "action": "activate",
        "description": "Space"
      }
    ],
    "aria": {
      "role": "button",
      "attributes": [
        "aria-busy",
        "aria-disabled"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Button.tsx",
            "destination": "Button.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Button.vue",
            "destination": "button/Button.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/ButtonIcon.vue",
            "destination": "button/ButtonIcon.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "button/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied/prism-vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied/prism-vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied/prism-core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied/prism-tokens",
      "version": "^0.1.0",
