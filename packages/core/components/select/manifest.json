{
  "metadata": {
    "name": "select",
    "displayName": "Select",
    "description": "A select-only combobox (not a native select), composed from parts: a button-like SelectTrigger showing SelectValue, and a SelectContent listbox of SelectItem options, optionally in labelled SelectGroups. Items register through context. Typeahead, form submission via a hidden input, and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "overlays",
    "keywords": [
      "select",
      "combobox",
      "listbox",
      "dropdown",
      "picker",
      "form"
    ]
  },
  "contract": {
    "element": "button",
    "anchor": "trigger",
    "slots": {
      "root": {
        "element": "div"
      },
      "trigger": {
        "element": "button",
        "role": "combobox"
      },
      "value": {
        "element": "span"
      },
      "listbox": {
        "element": "div",
        "role": "listbox"
      },
      "option": {
        "element": "div",
        "role": "option"
      },
      "group": {
        "element": "div",
        "role": "group",
        "optional": true
      },
      "label": {
        "element": "div",
        "role": "presentation",
        "optional": true
      },
      "separator": {
        "element": "div",
        "optional": true
      }
    },
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md",
          "lg"
        ],
        "default": "md"
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "required": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      "open",
      "closed"
    ],
    "parts": [
      "placeholder",
      "icon"
    ],
    "keyboard": [
      {
        "keys": [
          "ArrowDown",
          "ArrowUp",
          "Enter",
          " "
        ],
        "action": "open",
        "description": "When closed: open, highlighting the selected (or first) option"
      },
      {
        "keys": [
          "Home",
          "End"
        ],
        "action": "navigate",
        "description": "Open on / highlight the first / last option"
      },
      {
        "keys": [
          "ArrowDown",
          "ArrowUp"
        ],
        "action": "navigate",
        "description": "When open: move the highlight (no wrapping), skipping disabled options"
      },
      {
        "keys": [
          "Enter",
          " "
        ],
        "action": "select",
        "description": "When open: select the highlighted option and close"
      },
      {
        "keys": [
          "Tab"
        ],
        "action": "select",
        "description": "When open: select the highlighted option, close, and move focus on"
      },
      {
        "keys": [
          "Escape"
        ],
        "action": "dismiss",
        "description": "Close without changing the selection"
      },
      {
        "keys": [
          "a-z"
        ],
        "action": "navigate",
        "description": "Typeahead: closed, selects the matching option; open, highlights it"
      }
    ],
    "aria": {
      "role": "combobox",
      "attributes": [
        "aria-haspopup",
        "aria-expanded",
        "aria-controls",
        "aria-activedescendant",
        "aria-required",
        "aria-invalid",
        "aria-describedby"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
