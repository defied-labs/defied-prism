{
  "metadata": {
    "name": "tabs",
    "displayName": "Tabs",
    "description": "Tabbed panels with roving focus, automatic or manual activation, and horizontal or vertical orientation.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "navigation",
    "keywords": [
      "tabs",
      "tablist",
      "tabpanel",
      "navigation"
    ]
  },
  "contract": {
    "element": "div",
    "anchor": "list",
    "slots": {
      "root": {
        "element": "div"
      },
      "list": {
        "element": "div",
        "role": "tablist"
      },
      "indicator": {
        "element": "span",
        "optional": true
      },
      "highlight": {
        "element": "span",
        "optional": true
      },
      "trigger": {
        "element": "button",
        "role": "tab"
      },
      "panel": {
        "element": "div",
        "role": "tabpanel"
      }
    },
    "props": {
      "orientation": {
        "type": "enum",
        "values": [
          "horizontal",
          "vertical"
        ],
        "default": "horizontal"
      },
      "variant": {
        "type": "enum",
        "values": [
          "line",
          "pills"
        ],
        "default": "line"
      },
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      },
      "activationMode": {
        "type": "enum",
        "values": [
          "automatic",
          "manual"
        ],
        "default": "automatic",
        "visual": false,
        "description": "automatic: arrow keys select the focused tab. manual: arrow keys move focus; Enter or Space selects."
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [
      {
        "keys": [
          "ArrowRight",
          "ArrowLeft"
        ],
        "action": "navigate",
        "description": "Horizontal: next / previous tab, wrapping"
      },
      {
        "keys": [
          "ArrowDown",
          "ArrowUp"
        ],
        "action": "navigate",
        "description": "Vertical: next / previous tab, wrapping"
      },
      {
        "keys": [
          "Home",
          "End"
        ],
        "action": "navigate",
        "description": "First / last enabled tab"
      },
      {
        "keys": [
          "Enter",
          " "
        ],
        "action": "select",
        "description": "Select the focused tab (manual activation)"
      }
    ],
    "aria": {
      "role": "tablist",
      "attributes": [
        "aria-orientation"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Tabs.tsx",
            "destination": "Tabs.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/index.ts",
            "destination": "tabs/index.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/context.ts",
            "destination": "tabs/context.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/styles.ts",
            "destination": "tabs/styles.ts",
