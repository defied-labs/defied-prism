{
  "name": "tabs",
  "base": {
    "display": "flex",
    "gap": "{space.3}",
    "fontFamily": "{font.sans}"
  },
  "slots": {
    "list": {
      "position": "relative",
      "isolation": "isolate",
      "display": "flex",
      "gap": "{space.1}"
    },
    "indicator": {
      "position": "absolute",
      "top": "0",
      "left": "0",
      "zIndex": "-1",
      "pointerEvents": "none",
      "transition": "transform {duration.normal} {easing.standard}, width {duration.normal} {easing.standard}, height {duration.normal} {easing.standard}"
    },
    "highlight": {
      "position": "absolute",
      "top": "0",
      "left": "0",
      "zIndex": "-1",
      "pointerEvents": "none",
      "background": "{color.muted}",
      "opacity": "0.6",
      "transition": "transform {duration.normal} {easing.standard}, width {duration.normal} {easing.standard}, height {duration.normal} {easing.standard}, opacity {duration.fast} {easing.standard}",
      "_closed": {
        "opacity": "0"
      }
    },
    "trigger": {
      "display": "inline-flex",
      "alignItems": "center",
      "justifyContent": "center",
      "gap": "{space.2}",
      "borderWidth": "0",
      "background": "transparent",
      "color": "{color.muted-fg}",
      "fontFamily": "inherit",
      "fontWeight": "{weight.medium}",
      "lineHeight": "{leading.tight}",
      "whiteSpace": "nowrap",
      "cursor": "pointer",
      "transition": "color {duration.fast} {easing.standard}, background-color {duration.fast} {easing.standard}, box-shadow {duration.fast} {easing.standard}",
      "_hover": {
        "color": "{color.fg}"
      },
      "_selected": {
        "color": "{color.fg}"
      },
      "_focusVisible": {
        "outline": "{focus.ring-width} solid {color.ring}",
        "outlineOffset": "{focus.ring-offset}"
      },
      "_disabled": {
        "opacity": "{opacity.disabled}",
        "cursor": "not-allowed"
      }
    },
    "panel": {
      "borderRadius": "{radius.sm}",
      "_focusVisible": {
        "outline": "{focus.ring-width} solid {color.ring}",
        "outlineOffset": "{focus.ring-offset}"
      }
    }
  },
  "variants": {
    "orientation": {
      "horizontal": {
        "flexDirection": "column",
        "slot:list": {
          "flexDirection": "row"
        },
        "slot:trigger": {
          "--prism-tabs-indicator": "inset 0 -2px 0 0"
        },
        "slot:indicator": {
          "--prism-tabs-indicator": "inset 0 -2px 0 0"
        }
      },
      "vertical": {
        "flexDirection": "row",
        "slot:list": {
          "flexDirection": "column"
        },
        "slot:trigger": {
          "--prism-tabs-indicator": "inset 2px 0 0 0"
        },
        "slot:indicator": {
          "--prism-tabs-indicator": "inset 2px 0 0 0"
        }
      }
    },
    "variant": {
      "line": {
        "slot:list": {
          "boxShadow": "inset 0 -1px 0 0 {color.border}"
        },
        "slot:trigger": {
          "borderRadius": "0",
          "_selected": {
            "boxShadow": "var(--prism-tabs-indicator) var(--prism-tabs-selected, {color.primary})"
          }
        },
        "slot:indicator": {
          "borderRadius": "0",
          "background": "transparent",
          "boxShadow": "var(--prism-tabs-indicator) {color.primary}"
        },
        "slot:highlight": {
          "borderRadius": "{radius.sm}"
        }
      },
      "pills": {
        "slot:list": {
          "boxShadow": "none"
        },
        "slot:trigger": {
          "borderRadius": "{radius.md}",
          "_selected": {
            "background": "var(--prism-tabs-selected, {color.muted})"
          }
        },
        "slot:indicator": {
          "borderRadius": "{radius.md}",
          "background": "{color.muted}",
          "boxShadow": "none"
        },
        "slot:highlight": {
          "borderRadius": "{radius.md}"
        }
      }
    },
    "size": {
      "sm": {
        "slot:trigger": {
          "minHeight": "{control.sm}",
          "paddingInline": "{space.3}",
          "fontSize": "{text.sm}"
        }
      },
      "md": {
        "slot:trigger": {
          "minHeight": "{control.md}",
          "paddingInline": "{space.4}",
          "fontSize": "{text.sm}"
        }
      }
    }
  },
  "defaultVariants": {
    "orientation": "horizontal",
    "variant": "line",
    "size": "md"
  }
}
