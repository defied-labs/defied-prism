{
  "metadata": {
    "name": "empty-state",
    "displayName": "Empty State",
    "description": "A placeholder for empty lists and searches: icon, heading, description and actions.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "feedback",
    "keywords": [
      "empty",
      "empty-state",
      "placeholder",
      "zero-state"
    ]
  },
  "contract": {
    "element": "div",
    "slots": {
      "root": {
        "element": "div"
      },
      "icon": {
        "element": "div",
        "optional": true
      },
      "title": {
        "element": "h3"
      },
      "description": {
        "element": "p"
      },
      "actions": {
        "element": "div",
        "optional": true
      }
    },
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "generic",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
