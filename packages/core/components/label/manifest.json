{
  "metadata": {
    "name": "label",
    "displayName": "Label",
    "description": "Form label with required indicator, dimmed look and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "forms",
    "keywords": [
      "label",
      "forms"
    ]
  },
  "contract": {
    "element": "label",
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      },
      "required": {
        "type": "boolean",
        "default": false,
        "description": "Shows an aria-hidden asterisk; the control itself carries required."
      },
      "dimmed": {
        "type": "boolean",
        "default": false,
        "description": "Disabled look; set automatically by the `disabled` prop or a disabled Field."
      }
    },
    "states": [],
    "parts": [
      "required-indicator"
    ],
    "keyboard": [],
    "aria": {
      "role": "none",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Label.tsx",
            "destination": "Label.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Label.vue",
            "destination": "label/Label.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "label/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-labs/prism-core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-labs/prism-tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.danger-fg",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.tight",
      "required": true
    },
    {
      "name": "opacity.disabled",
      "required": true
    },
    {
      "name": "space.1",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    },
    {
      "name": "text.xs",
      "required": true
    },
    {
      "name": "weight.medium",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": false,
    "screenReaderSupport": true,
    "ariaPatterns": []
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/label"
}
