{
  "metadata": {
    "name": "breadcrumb",
    "displayName": "Breadcrumb",
    "description": "A breadcrumb trail: a labelled nav landmark with an ordered list, decorative separators, the current page marked, and optional collapsing of middle items.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "navigation",
    "keywords": [
      "breadcrumb",
      "navigation",
      "trail"
    ]
  },
  "contract": {
    "element": "nav",
    "anchor": "root",
    "slots": {
      "root": {
        "element": "nav"
      },
      "list": {
        "element": "ol"
      },
      "item": {
        "element": "li"
      },
      "link": {
        "element": "a"
      },
      "page": {
        "element": "span"
      },
      "separator": {
        "element": "li"
      },
      "ellipsis": {
        "element": "button",
        "optional": true
      }
    },
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "navigation",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Breadcrumb.tsx",
            "destination": "Breadcrumb.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/index.ts",
            "destination": "breadcrumb/index.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/Breadcrumb.vue",
            "destination": "breadcrumb/Breadcrumb.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/BreadcrumbItem.vue",
            "destination": "breadcrumb/BreadcrumbItem.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/BreadcrumbLink.vue",
            "destination": "breadcrumb/BreadcrumbLink.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/BreadcrumbPage.vue",
            "destination": "breadcrumb/BreadcrumbPage.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/context.ts",
            "destination": "breadcrumb/context.ts",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/styles.ts",
            "destination": "breadcrumb/styles.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.muted-fg",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "duration.fast",
      "required": true
    },
    {
      "name": "easing.standard",
      "required": true
    },
    {
      "name": "focus.ring-offset",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
