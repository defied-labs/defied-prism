{
  "metadata": {
    "name": "inline",
    "displayName": "Inline",
    "description": "Horizontal, wrapping flex layout with token-based gap, alignment and justification.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "layout",
    "keywords": [
      "inline",
      "layout"
    ]
  },
  "contract": {
    "element": "div",
    "props": {
      "gap": {
        "type": "enum",
        "values": [
          "none",
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ],
        "default": "sm"
      },
      "align": {
        "type": "enum",
        "values": [
          "start",
          "center",
          "end",
          "baseline",
          "stretch"
        ],
        "default": "center"
      },
      "justify": {
        "type": "enum",
        "values": [
          "start",
          "center",
          "end",
          "between"
        ],
        "default": "start"
      },
      "wrap": {
        "type": "enum",
        "values": [
          "wrap",
          "nowrap"
        ],
        "default": "wrap"
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "generic",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Inline.tsx",
            "destination": "Inline.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Inline.vue",
            "destination": "inline/Inline.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "inline/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "space.1",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "space.4",
      "required": true
    },
    {
      "name": "space.6",
      "required": true
    },
    {
      "name": "space.8",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": false,
    "screenReaderSupport": true,
    "ariaPatterns": []
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/inline"
}
