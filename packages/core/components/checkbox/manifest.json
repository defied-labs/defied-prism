{
  "metadata": {
    "name": "checkbox",
    "displayName": "Checkbox",
    "description": "A native checkbox with a styled box, indeterminate state, label and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "forms",
    "keywords": [
      "checkbox",
      "form",
      "toggle"
    ]
  },
  "contract": {
    "element": "input",
    "slots": {
      "root": {
        "element": "input"
      },
      "label": {
        "element": "label"
      },
      "control": {
        "element": "span"
      }
    },
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      },
      "indeterminate": {
        "type": "boolean",
        "default": false,
        "description": "Mixed state: sets the DOM indeterminate property and aria-checked=\"mixed\"."
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      "checked",
      "unchecked",
      "indeterminate"
    ],
    "parts": [
      "indicator",
      "mark"
    ],
    "keyboard": [
      {
        "keys": [
          " "
        ],
        "action": "activate",
        "description": "Space toggles"
      }
    ],
    "aria": {
      "role": "checkbox",
      "attributes": [
        "aria-checked",
        "aria-invalid",
        "aria-describedby"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Checkbox.tsx",
            "destination": "Checkbox.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      },
      {
        "framework": "vue",
        "minVersion": "3.4.0",
        "files": [
          {
            "source": "templates/vue/Checkbox.vue",
            "destination": "checkbox/Checkbox.vue",
            "type": "component",
            "editable": true
          },
          {
            "source": "templates/vue/index.ts",
            "destination": "checkbox/index.ts",
            "type": "component",
            "editable": true
          }
        ],
        "dependencies": [
          {
            "package": "vue",
            "version": ">=3.4.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-labs/prism-vue",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ],
        "runtimeVersion": {
          "package": "@defied-labs/prism-vue",
          "version": "^0.1.0"
        }
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-labs/prism-core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-labs/prism-tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.bg",
      "required": true
    },
    {
      "name": "color.border-strong",
      "required": true
    },
    {
      "name": "color.danger-solid",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.primary",
      "required": true
    },
    {
      "name": "color.primary-fg",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "duration.fast",
      "required": true
    },
    {
      "name": "duration.normal",
      "required": true
    },
    {
      "name": "easing.emphasized",
      "required": true
    },
    {
      "name": "easing.standard",
      "required": true
    },
    {
      "name": "focus.ring-offset",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.tight",
      "required": true
    },
    {
      "name": "opacity.disabled",
      "required": true
    },
    {
      "name": "radius.sm",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "text.md",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": true,
    "screenReaderSupport": true,
    "ariaPatterns": [
      "checkbox"
    ]
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/checkbox"
}
