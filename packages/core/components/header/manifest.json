{
  "metadata": {
    "name": "header",
    "displayName": "Header",
    "description": "A site header: brand, navigation and actions. Menus open on hover (or click) on one shared surface that glides from menu to menu; below a breakpoint the navigation becomes a full-screen panel that slides in.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "navigation",
    "keywords": [
      "header",
      "navbar",
      "navigation",
      "site header",
      "menu",
      "disclosure"
    ]
  },
  "contract": {
    "element": "header",
    "anchor": "root",
    "slots": {
      "root": {
        "element": "header"
      },
      "brand": {
        "element": "a"
      },
      "nav": {
        "element": "nav"
      },
      "viewport": {
        "element": "div"
      },
      "list": {
        "element": "ul"
      },
      "item": {
        "element": "li"
      },
      "trigger": {
        "element": "button"
      },
      "content": {
        "element": "div",
        "optional": true
      },
      "panel": {
        "element": "div",
        "optional": true
      },
      "link": {
        "element": "a"
      },
      "actions": {
        "element": "div"
      },
      "toggle": {
        "element": "button"
      },
      "close": {
        "element": "button",
        "optional": true
      }
    },
    "props": {
      "variant": {
        "type": "enum",
        "values": [
          "bar",
          "floating"
        ],
        "default": "bar",
        "visual": true
      },
      "position": {
        "type": "enum",
        "values": [
          "static",
          "sticky",
          "fixed"
        ],
        "default": "sticky",
        "visual": true
      }
    },
    "states": [
      "open",
      "closed"
    ],
    "parts": [
      "media",
      "body",
      "title",
      "description",
      "icon"
    ],
    "keyboard": [
      {
        "keys": [
          "Enter",
          " "
        ],
        "action": "select",
        "description": "On a menu trigger, open or close its menu; on the toggle, open or close the collapsed navigation"
      },
      {
        "keys": [
          "Escape"
        ],
        "action": "dismiss",
        "description": "Close the open menu (focus returns to its trigger), then the collapsed navigation (focus returns to the toggle)"
      },
      {
        "keys": [
          "Tab"
        ],
        "action": "navigate",
        "description": "Tabbing past an open menu closes it; while the collapsed navigation is open, focus stays inside it"
      }
    ],
    "aria": {
      "role": "banner",
      "attributes": []
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
