{
  "metadata": {
    "name": "radio-group",
    "displayName": "Radio Group",
    "description": "A group of native radio buttons sharing a name, with roving arrow-key selection and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "forms",
    "keywords": [
      "radio",
      "radiogroup",
      "form",
      "choice"
    ]
  },
  "contract": {
    "element": "div",
    "slots": {
      "root": {
        "element": "div",
        "role": "radiogroup"
      },
      "item": {
        "element": "label"
      },
      "control": {
        "element": "span"
      },
      "radio": {
        "element": "input"
      }
    },
    "props": {
      "orientation": {
        "type": "enum",
        "values": [
          "horizontal",
          "vertical"
        ],
        "default": "vertical"
      },
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md"
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [],
    "parts": [
      "indicator"
    ],
    "keyboard": [
      {
        "keys": [
          "ArrowDown",
          "ArrowRight"
        ],
        "action": "navigate",
        "description": "Select the next radio, wrapping (native)"
      },
      {
        "keys": [
          "ArrowUp",
          "ArrowLeft"
        ],
        "action": "navigate",
        "description": "Select the previous radio, wrapping (native)"
      },
      {
        "keys": [
          " "
        ],
        "action": "select",
        "description": "Select the focused radio"
      }
    ],
    "aria": {
      "role": "radiogroup",
      "attributes": [
        "aria-orientation",
        "aria-invalid",
        "aria-describedby",
        "aria-required",
        "aria-disabled"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/RadioGroup.tsx",
            "destination": "RadioGroup.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.bg",
      "required": true
    },
    {
      "name": "color.border-strong",
      "required": true
    },
    {
      "name": "color.danger-solid",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.primary",
      "required": true
    },
    {
      "name": "color.primary-fg",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "duration.fast",
      "required": true
    },
    {
      "name": "easing.standard",
      "required": true
    },
    {
      "name": "focus.ring-offset",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.tight",
      "required": true
    },
    {
      "name": "opacity.disabled",
      "required": true
    },
    {
      "name": "radius.full",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "space.3",
      "required": true
    },
    {
      "name": "text.md",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": true,
    "screenReaderSupport": true,
    "ariaPatterns": [
      "radio"
    ]
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/radio-group"
}
