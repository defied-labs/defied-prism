{
  "metadata": {
    "name": "textarea",
    "displayName": "Textarea",
    "description": "A multi-line text field with resize control, optional auto-grow and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "primitive",
    "status": "beta",
    "category": "forms",
    "keywords": [
      "textarea",
      "form",
      "text",
      "multiline"
    ]
  },
  "contract": {
    "element": "textarea",
    "props": {
      "variant": {
        "type": "enum",
        "values": [
          "outlined",
          "filled"
        ],
        "default": "outlined"
      },
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md",
          "lg"
        ],
        "default": "md"
      },
      "resize": {
        "type": "enum",
        "values": [
          "none",
          "vertical",
          "both"
        ],
        "default": "vertical"
      },
      "fullWidth": {
        "type": "boolean",
        "default": false
      },
      "autoResize": {
        "type": "boolean",
        "default": false,
        "description": "Grows the height with the content."
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [],
    "parts": [],
    "keyboard": [],
    "aria": {
      "role": "textbox",
      "attributes": [
        "aria-invalid",
        "aria-describedby"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
            "source": "templates/react/Textarea.tsx",
            "destination": "Textarea.tsx",
            "type": "component",
            "editable": true
          }
        ],
        "runtimeVersion": {
          "package": "@defied-prism/react",
          "version": "^0.1.0"
        },
        "dependencies": [
          {
            "package": "react",
            "version": ">=18.0.0",
            "type": "peerDependency"
          },
          {
            "package": "@defied-prism/react",
            "version": "^0.1.0",
            "type": "dependency"
          }
        ]
      }
    ],
    "styling": [
      "tailwind",
      "css-modules",
      "css"
    ]
  },
  "dependencies": [
    {
      "package": "@defied-prism/core",
      "version": "^0.1.0",
      "type": "dependency"
    },
    {
      "package": "@defied-prism/tokens",
      "version": "^0.1.0",
      "type": "dependency"
    }
  ],
  "tokens": [
    {
      "name": "color.bg",
      "required": true
    },
    {
      "name": "color.border-strong",
      "required": true
    },
    {
      "name": "color.danger-solid",
      "required": true
    },
    {
      "name": "color.fg",
      "required": true
    },
    {
      "name": "color.muted",
      "required": true
    },
    {
      "name": "color.muted-fg",
      "required": true
    },
    {
      "name": "color.ring",
      "required": true
    },
    {
      "name": "duration.fast",
      "required": true
    },
    {
      "name": "easing.standard",
      "required": true
    },
    {
      "name": "focus.ring-width",
      "required": true
    },
    {
      "name": "font.sans",
      "required": true
    },
    {
      "name": "leading.normal",
      "required": true
    },
    {
      "name": "opacity.disabled",
      "required": true
    },
    {
      "name": "radius.lg",
      "required": true
    },
    {
      "name": "radius.md",
      "required": true
    },
    {
      "name": "space.1",
      "required": true
    },
    {
      "name": "space.2",
      "required": true
    },
    {
      "name": "space.3",
      "required": true
    },
    {
      "name": "space.4",
      "required": true
    },
    {
      "name": "text.md",
      "required": true
    },
    {
      "name": "text.sm",
      "required": true
    }
  ],
  "accessibility": {
    "keyboardSupport": true,
    "screenReaderSupport": true,
    "ariaPatterns": [
      "textbox"
    ]
  },
  "tests": {
    "unit": true,
    "accessibility": true,
    "visual": false,
    "e2e": false
  },
  "migrations": [],
  "registryPath": "components/textarea"
}
