{
  "name": "textarea",
  "base": {
    "display": "block",
    "boxSizing": "border-box",
    "minWidth": "0",
    "color": "{color.fg}",
    "fontFamily": "{font.sans}",
    "lineHeight": "{leading.normal}",
    "borderWidth": "1px",
    "borderStyle": "solid",
    "borderColor": "{color.border-strong}",
    "transition": "border-color {duration.fast} {easing.standard}",
    "_placeholder": {
      "color": "{color.muted-fg}"
    },
    "_hover": {
      "borderColor": "{color.fg}"
    },
    "_focusVisible": {
      "outline": "{focus.ring-width} solid {color.ring}",
      "outlineOffset": "0"
    },
    "_invalid": {
      "borderColor": "{color.danger-solid}"
    },
    "_disabled": {
      "opacity": "{opacity.disabled}",
      "cursor": "not-allowed"
    }
  },
  "variants": {
    "variant": {
      "outlined": {
        "background": "{color.bg}"
      },
      "filled": {
        "background": "{color.muted}"
      }
    },
    "size": {
      "sm": {
        "minHeight": "4rem",
        "paddingInline": "{space.2}",
        "paddingBlock": "{space.1}",
        "fontSize": "{text.sm}",
        "borderRadius": "{radius.md}"
      },
      "md": {
        "minHeight": "5rem",
        "paddingInline": "{space.3}",
        "paddingBlock": "{space.2}",
        "fontSize": "{text.sm}",
        "borderRadius": "{radius.md}"
      },
      "lg": {
        "minHeight": "6rem",
        "paddingInline": "{space.4}",
        "paddingBlock": "{space.3}",
        "fontSize": "{text.md}",
        "borderRadius": "{radius.lg}"
      }
    },
    "resize": {
      "none": {
        "resize": "none"
      },
      "vertical": {
        "resize": "vertical"
      },
      "both": {
        "resize": "both"
      }
    },
    "fullWidth": {
      "true": {
        "width": "100%"
      }
    }
  },
  "defaultVariants": {
    "variant": "outlined",
    "size": "md",
    "resize": "vertical"
  }
}
