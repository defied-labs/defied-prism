{
  "name": "combobox",
  "base": {
    "position": "relative",
    "display": "flex",
    "flexDirection": "column",
    "gap": "{space.1-5}",
    "fontFamily": "{font.sans}",
    "color": "{color.fg}"
  },
  "slots": {
    "input": {},
    "listbox": {
      "position": "absolute",
      "zIndex": "{z.dropdown}",
      "top": "100%",
      "left": "0",
      "right": "0",
      "marginTop": "{space.1}",
      "boxSizing": "border-box",
      "borderRadius": "{radius.md}",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "{color.border}",
      "background": "{color.bg}",
      "boxShadow": "{shadow.lg}",
      "animation": "prism-roll-in {duration.normal} {easing.standard}",
      "padding": "{space.1}",
      "maxHeight": "16rem",
      "overflowY": "auto",
      "transformOrigin": "top",
      "_closed": {
        "pointerEvents": "none",
        "animation": "prism-roll-out {duration.fast} {easing.exit} forwards"
      }
    },
    "option": {
      "display": "flex",
      "alignItems": "center",
      "paddingBlock": "{space.1-5}",
      "paddingInline": "{space.2}",
      "borderRadius": "{radius.sm}",
      "fontSize": "{text.sm}",
      "cursor": "pointer",
      "userSelect": "none",
      "_highlighted": {
        "background": "{color.muted}"
      },
      "_selected": {
        "fontWeight": "{weight.semibold}"
      },
      "_ariaDisabled": {
        "opacity": "{opacity.disabled}",
        "cursor": "not-allowed"
      }
    },
    "group": {},
    "label": {
      "paddingBlock": "{space.1-5}",
      "paddingInline": "{space.2}",
      "color": "{color.muted-fg}",
      "fontSize": "{text.xs}",
      "fontWeight": "{weight.semibold}"
    },
    "empty": {
      "position": "absolute",
      "zIndex": "{z.dropdown}",
      "top": "100%",
      "left": "0",
      "right": "0",
      "marginTop": "{space.1}",
      "boxSizing": "border-box",
      "borderRadius": "{radius.md}",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "{color.border}",
      "background": "{color.bg}",
      "boxShadow": "{shadow.lg}",
      "animation": "prism-fade-in {duration.fast} {easing.standard}",
      "padding": "{space.2}",
      "color": "{color.muted-fg}",
      "fontSize": "{text.sm}"
    }
  },
  "variants": {
    "size": {
      "sm": {},
      "md": {},
      "lg": {}
    }
  },
  "defaultVariants": {
    "size": "md"
  }
}
