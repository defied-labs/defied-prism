{
  "metadata": {
    "name": "combobox",
    "displayName": "Combobox",
    "description": "An editable combobox with list autocomplete, composed from parts: ComboboxInput, a ComboboxContent listbox of ComboboxItem options (optionally in labelled ComboboxGroups) and ComboboxEmpty. Items register through context; built-in accent-insensitive filtering that can be replaced or disabled. Form submission via a hidden input and Field integration.",
    "version": "0.1.0",
    "manifestVersion": "1.0",
    "type": "compound",
    "status": "beta",
    "category": "forms",
    "keywords": [
      "combobox",
      "autocomplete",
      "select",
      "listbox",
      "search"
    ]
  },
  "contract": {
    "element": "input",
    "anchor": "input",
    "slots": {
      "root": {
        "element": "div"
      },
      "input": {
        "element": "input",
        "role": "combobox"
      },
      "listbox": {
        "element": "div",
        "role": "listbox"
      },
      "option": {
        "element": "div",
        "role": "option"
      },
      "group": {
        "element": "div",
        "role": "group",
        "optional": true
      },
      "label": {
        "element": "div",
        "role": "presentation",
        "optional": true
      },
      "empty": {
        "element": "div",
        "role": "status",
        "optional": true
      }
    },
    "props": {
      "size": {
        "type": "enum",
        "values": [
          "sm",
          "md",
          "lg"
        ],
        "default": "md"
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "required": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      "open",
      "closed"
    ],
    "parts": [],
    "keyboard": [
      {
        "keys": [
          "ArrowDown"
        ],
        "action": "navigate",
        "description": "Open the list, or highlight the next option"
      },
      {
        "keys": [
          "ArrowUp"
        ],
        "action": "navigate",
        "description": "Open the list at the last option, or highlight the previous one"
      },
      {
        "keys": [
          "Enter"
        ],
        "action": "select",
        "description": "Select the highlighted option"
      },
      {
        "keys": [
          "Escape"
        ],
        "action": "dismiss",
        "description": "Close the list"
      },
      {
        "keys": [
          "Alt+ArrowDown"
        ],
        "action": "open",
        "description": "Open without highlighting"
      }
    ],
    "aria": {
      "role": "combobox",
      "attributes": [
        "aria-autocomplete",
        "aria-expanded",
        "aria-controls",
        "aria-activedescendant",
        "aria-required",
        "aria-invalid",
        "aria-describedby"
      ]
    }
  },
  "compatibility": {
    "frameworks": [
      {
        "framework": "react",
        "minVersion": "18.0.0",
        "files": [
          {
