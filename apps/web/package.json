    "@defied/prism-vue-demos": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-form": "^1.33.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "catalog:",
    "fumadocs-core": "^16.15.18",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "^16.15.18",
    "lucide-react": "^1.21.0",
    "motion": "^13.1.1",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
