{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "pnpm snippets && tsc --noEmit",
    "lint": "eslint .",
    "dev": "pnpm snippets && pnpm --filter @defied/prism-vue-demos build && next dev --port 3001",
    "build": "pnpm snippets && next build",
    "start": "next start",
    "test": "pnpm snippets && vitest run --passWithNoTests",
    "snippets": "tsx scripts/generate-snippets.ts && tsx scripts/generate-docs.ts && tsx scripts/generate-api.ts"
  },
  "dependencies": {
    "@defied/prism-core": "workspace:*",
